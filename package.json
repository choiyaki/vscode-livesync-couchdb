{
  "name": "vscode-livesync-couchdb",
  "displayName": "LiveSync CouchDB",
  "description": "CouchDB-only LiveSync extension for VS Code workspaces.",
  "version": "0.4.1",
  "publisher": "local-dev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/choiyaki/vscode-livesync-couchdb.git"
  },
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "README.md",
    "package.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "livesync.configure",
        "title": "LiveSync: Configure CouchDB"
      },
      {
        "command": "livesync.testConnection",
        "title": "LiveSync: Test CouchDB Connection"
      },
      {
        "command": "livesync.syncNow",
        "title": "LiveSync: Sync Now"
      },
      {
        "command": "livesync.pushNow",
        "title": "LiveSync: Push Now"
      },
      {
        "command": "livesync.pullNow",
        "title": "LiveSync: Pull Now"
      },
      {
        "command": "livesync.pullFullNow",
        "title": "LiveSync: Full Pull Now"
      },
      {
        "command": "livesync.showConflicts",
        "title": "LiveSync: Show Conflicts"
      },
      {
        "command": "livesync.resolveConflict",
        "title": "LiveSync: Resolve Conflict"
      }
    ],
    "configuration": {
      "title": "LiveSync CouchDB",
      "properties": {
        "livesync.couchdb.url": {
          "type": "string",
          "default": "",
          "description": "Base URL of the CouchDB server, for example https://example.com:6984"
        },
        "livesync.couchdb.database": {
          "type": "string",
          "default": "",
          "description": "Database name to sync with"
        },
        "livesync.couchdb.username": {
          "type": "string",
          "default": "",
          "description": "CouchDB username"
        },
        "livesync.syncOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Push the saved file after VS Code saves it"
        },
        "livesync.syncOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Run a full sync automatically when the extension activates"
        },
        "livesync.autoSyncIntervalSeconds": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Pull from CouchDB every N seconds. Set to 0 to disable."
        },
        "livesync.include": {
          "type": "string",
          "default": "**/*.md",
          "description": "Glob of files to include during sync"
        },
        "livesync.syncedFolders": {
          "type": "string",
          "default": "",
          "description": "Comma-separated folder names to sync in addition to root-level files. Root files (no slash) are always synced. Matching is case-insensitive. Leave empty to sync root-level files only (subfolders excluded). Mirrors couchNotes' syncedFolders."
        },
        "livesync.exclude": {
          "type": "string",
          "default": "**/.git/**,**/node_modules/**,**/.obsidian/**,**/.vscode/**,**/.DS_Store",
          "description": "Comma-separated globs to exclude from sync"
        },
        "livesync.liveSync": {
          "type": "boolean",
          "default": false,
          "description": "Enable real-time sync: use CouchDB long-polling to detect remote changes instantly instead of (or in addition to) the interval timer."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package:vsix": "npx @vscode/vsce package --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/vscode": "^1.98.0",
    "@vscode/vsce": "^3.7.1",
    "typescript": "^5.8.2"
  }
}
