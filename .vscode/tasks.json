{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "compile",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"presentation": {
				"reveal": "silent"
			},
			"problemMatcher": "$tsc"
		},
		{
			"type": "npm",
			"script": "watch",
			"group": "build",
			"presentation": {
				"reveal": "silent"
			},
			"problemMatcher": "$tsc-watch",
			"isBackground": true
		},
		{
			"label": "Package VSIX",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npx @vscode/vsce package --skip-license"
			],
			"group": "build"
		},
		{
			"label": "Compile and Package v0.0.2",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npm run compile && npm run package:vsix"
			],
			"group": "build"
		},
		{
			"label": "Build v0.0.2",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npm run compile && npm run package:vsix"
			],
			"group": "build"
		},
		{
			"label": "Build and Package v0.0.2",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npm run compile && npm run package:vsix"
			],
			"group": "build"
		},
		{
			"label": "Build and Package VSIX",
			"type": "shell",
			"command": "cmd",
			"args": [
				"/c",
				"npm run compile && npm run package:vsix"
			],
			"group": "build"
		}
	]
}